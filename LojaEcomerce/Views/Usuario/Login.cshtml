@model LojaEcomerce.Models.LoginViewModel

@{
	ViewData["Title"] = "Login";
}

@*centraliza o conteudo da tela*@
<div>
	@*Define a largura maxima do container*@
	<div>
		@*Estrutura que vai receber o form*@
		<div>
			@*Estrutura do cabeçalho*@
			<div>
				<h3 class="">Login</h3>
			</div>
			<section>
				<form asp-action="Login" method="post">
					<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
					<div>
						<label asp-for="Email"></label>
						<input asp-for="Email" placeholder="email@email.com" />
						<span asp-validation-for="Email"></span>
					</div>
				</br>
					<div>
						<label asp-for="Senha"></label>
						<input asp-for="Senha" placeholder="Digite sua Senha" type="password" />
						<span asp-validation-for="Senha"></span>
					</div>
					<div>
				</br>
						<button class="btn-success">Entrar</button>
					</div>
					<div>
						</br>
						<p>Ainda não possui conta?</p>
						<a asp-action="CriarConta" asp-controller="Usuario">
							Criar uma nova conta
						</a>
					</div>
				</form>

			</section>
		</div>